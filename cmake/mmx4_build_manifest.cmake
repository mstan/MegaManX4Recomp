# Use the SDK's declared-input producer. Keep its changing header off generated
# guest sources; only the startup owner consumes this separate build identity.
include("${PSXRECOMP_V4_ROOT}/cmake/psx_build_manifest.cmake")

function(mmx4_scope_manifest_definition target)
    get_target_property(_definitions ${target} COMPILE_DEFINITIONS)
    list(FILTER _definitions EXCLUDE REGEX "^PSX_BUILD_MANIFEST_CONFIG=")
    set_property(TARGET ${target} PROPERTY COMPILE_DEFINITIONS "${_definitions}")
endfunction()

function(mmx4_register_build_manifest)
    find_package(Git REQUIRED)
    set(_roots "game=${CMAKE_SOURCE_DIR}" "build=${CMAKE_BINARY_DIR}"
        "game-generated=${CMAKE_SOURCE_DIR}/generated" "sdk=${PSXRECOMP_V4_ROOT}")
    set(_headers "${CMAKE_SOURCE_DIR}/src" "${CMAKE_SOURCE_DIR}/generated"
        "${PSXRECOMP_V4_ROOT}/runtime/include")
    set(_inputs "${CMAKE_SOURCE_DIR}/CMakeLists.txt" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        "${CMAKE_SOURCE_DIR}/game.toml")
    set(_identities "")
    foreach(_label game sdk ui net rb)
        if(_label STREQUAL "game")
            set(_path "${CMAKE_SOURCE_DIR}")
        elseif(_label STREQUAL "sdk")
            set(_path "${PSXRECOMP_V4_ROOT}")
        elseif(_label STREQUAL "ui")
            set(_path "${RECOMP_UI_ROOT}")
        elseif(_label STREQUAL "net")
            set(_path "${RECOMP_NET_ROOT}")
        else()
            set(_path "${RECOMP_RBENGINE_ROOT}")
        endif()
        if(NOT _path)
            continue()
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_path}" rev-parse --verify HEAD
            OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        list(APPEND _identities "${_label}@${_head}")
        if(NOT _label STREQUAL "game" AND NOT _label STREQUAL "sdk")
            list(APPEND _roots "${_label}=${_path}")
            list(APPEND _inputs "${_path}/CMakeLists.txt")
            foreach(_subdir src include)
                if(IS_DIRECTORY "${_path}/${_subdir}")
                    list(APPEND _headers "${_path}/${_subdir}")
                endif()
            endforeach()
        endif()
    endforeach()
    file(GLOB _recipes CONFIGURE_DEPENDS "${PSXRECOMP_V4_ROOT}/cmake/*.cmake"
        "${PSXRECOMP_V4_ROOT}/runtime/*.cmake")
    list(APPEND _inputs ${_recipes})
    get_filename_component(_compiler_bin "${CMAKE_C_COMPILER}" DIRECTORY)
    get_filename_component(_toolchain "${_compiler_bin}/.." ABSOLUTE)
    list(APPEND _roots "toolchain=${_toolchain}")
    foreach(_source_dir psx_libchdr_SOURCE_DIR psx_libwebp_SOURCE_DIR libjuice_SOURCE_DIR)
        if(DEFINED ${_source_dir} AND IS_DIRECTORY "${${_source_dir}}")
            list(APPEND _roots "dep-${_source_dir}=${${_source_dir}}")
        endif()
    endforeach()
    set(_manifest_dir "${CMAKE_BINARY_DIR}/psx_build_manifest/psx-runtime$<$<BOOL:$<CONFIG>>:/$<CONFIG>>")
    set_property(SOURCE "${PSXRECOMP_V4_ROOT}/runtime/src/main.cpp" APPEND PROPERTY COMPILE_DEFINITIONS
        "$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,psx-runtime>:PSX_BUILD_MANIFEST_CONFIG=\"${_manifest_dir}/manifest.h\">")
    psxrecomp_build_manifest(psx-runtime ROOTS ${_roots} INPUTS ${_inputs}
        HEADER_DIRECTORIES ${_headers} DEPENDENCY_IDENTITIES ${_identities})
    cmake_language(DEFER CALL mmx4_scope_manifest_definition psx-runtime)
endfunction()
